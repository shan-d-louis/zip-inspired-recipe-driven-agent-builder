# Copy to .env and fill in. Never commit .env.

# --- LLM providers (free tiers) ---
# fake = scripted offline model, no keys needed (default). live = real models:
# every provider with a key AND a model ID is used, Gemini first, then Groq.
# The demo deployment runs on Groq only: leave GEMINI_API_KEY empty.
LLM_MODE=fake
GEMINI_API_KEY=
GROQ_API_KEY=
# Model IDs change often on free tiers: check the exact strings in
# Google AI Studio (aistudio.google.com) and console.groq.com/docs/models.
# Suggestions as of Oct 2026: a Gemini Flash / Flash-Lite model, and openai/gpt-oss-120b on Groq.
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=openai/gpt-oss-120b
# How hard Groq reasoning models think: low | medium | high. "low" cuts token use a lot.
# Leave empty for Groq models that have no reasoning setting.
GROQ_REASONING_EFFORT=low

# --- Engine ---
MAX_AGENT_STEPS=5
LLM_TIMEOUT_SECONDS=12
RUN_TIMEOUT_S=25

# --- Email relay (Phase 3b; leave EMAIL_RELAY_URL empty to hide the Send button) ---
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
EMAIL_DAILY_CAP=80
SENDER_NAME=
SENDER_GITHUB=
SENDER_LINKEDIN=
